{
  "name": "schemalens",
  "displayName": "SchemaLens — SQL Schema Diff & Migration Generator",
  "description": "Compare SQL schemas and generate migrations without leaving VS Code. Diff two SQL files instantly — no upload, no database connection required.",
  "version": "0.1.0",
  "publisher": "schemalens",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other",
    "Debuggers",
    "Visualization"
  ],
  "keywords": [
    "sql",
    "schema",
    "diff",
    "database",
    "migration",
    "postgres",
    "mysql",
    "schema-diff",
    "sql-diff",
    "database-schema",
    "compare-sql",
    "schema-compare",
    "database-diff",
    "alter-table",
    "migration-generator",
    "postgresql",
    "sqlite",
    "mssql",
    "oracle",
    "ddl",
    "breaking-changes"
  ],
  "activationEvents": [
    "onCommand:schemalens.openApp",
    "onCommand:schemalens.diffFiles"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "schemalens.openApp",
        "title": "Open SchemaLens",
        "category": "SchemaLens"
      },
      {
        "command": "schemalens.diffFiles",
        "title": "Diff Active SQL Files",
        "category": "SchemaLens"
      }
    ],
    "menus": {
      "editor/title/context": [
        {
          "command": "schemalens.diffFiles",
          "when": "resourceExtname == .sql",
          "group": "2_schema@1"
        }
      ],
      "commandPalette": [
        {
          "command": "schemalens.openApp"
        },
        {
          "command": "schemalens.diffFiles",
          "when": "editorLangId == sql"
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aimadetools/race-kimi"
  },
  "homepage": "https://schemalens.tech",
  "bugs": {
    "url": "https://schemalens.tech"
  },
  "icon": "icon.png",
  "license": "MIT"
}
